# ==============================================================================
# Cafe AI Waiter Ordering Service - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# Generate a strong 32+ character key for production (e.g., openssl rand -hex 32)
SECRET_KEY=dev-secret-key-change-in-production-cafe-ai-waiter-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CUSTOMER_SESSION_EXPIRE_MINUTES=240
WS_TICKET_EXPIRE_SECONDS=60

# Authoritative Database (MongoDB Replica Set)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cafe_ai_waiter

# Cache & Ephemeral State (Redis - optional in local dev fallback)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# Primary AI Provider (OpenAI-compatible endpoint - Gemini Flash-Lite / Flash)
# For Gemini via Google's OpenAI-compatible layer:
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=your-gemini-or-openai-api-key-here
AI_MODEL=gemini-2.0-flash

# Optional Secondary Fallback AI Provider
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# Cloudflare R2 Object Storage (S3-compatible)
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PRIVATE_BUCKET=cafe-private-uploads
R2_PUBLIC_BUCKET=cafe-public-assets
R2_PUBLIC_URL_BASE=https://assets.yourcafedomain.com
